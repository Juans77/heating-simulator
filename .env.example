#############################################
# Techloop Sim - Environment Variables
#############################################

# ===============================
# PostgreSQL
# ===============================
POSTGRES_DB=homeassistant
POSTGRES_USER=ha_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ===============================
# Home Assistant
# ===============================
# Usato in configuration.yaml
HA_DB_URL=postgresql://ha_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/homeassistant

# ===============================
# pgAdmin (opzionale)
# ===============================
PGADMIN_DEFAULT_EMAIL=admin@techloop.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ===============================
# MQTT (Mosquitto)
# ===============================
MQTT_BROKER=mosquitto
MQTT_PORT=1883

# ===============================
# Project / Docker
# ===============================
TZ=Europe/Rome
